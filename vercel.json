{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "functions": {
    "api/index.py": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/consensus-refresh",
      "schedule": "0 5 * * 1-5"
    },
    {
      "path": "/api/cron/consensus-refresh",
      "schedule": "30 5 * * 1-5"
    },
    {
      "path": "/api/cron/consensus-refresh",
      "schedule": "0 6 * * 1-5"
    },
    {
      "path": "/api/cron/consensus-refresh",
      "schedule": "30 6 * * 1-5"
    },
    {
      "path": "/api/cron/consensus-refresh",
      "schedule": "0 7 * * 1-5"
    },
    {
      "path": "/api/cron/consensus-refresh",
      "schedule": "30 7 * * 1-5"
    },
    {
      "path": "/api/cron/consensus-refresh",
      "schedule": "0 8 * * 1-5"
    },
    {
      "path": "/api/cron/consensus-refresh",
      "schedule": "30 8 * * 1-5"
    },
    {
      "path": "/api/cron/consensus-refresh",
      "schedule": "0 9 * * 1-5"
    },
    {
      "path": "/api/cron/consensus-refresh",
      "schedule": "30 9 * * 1-5"
    },
    {
      "path": "/api/cron/consensus-refresh",
      "schedule": "0 10 * * 1-5"
    },
    {
      "path": "/api/cron/consensus-refresh",
      "schedule": "30 10 * * 1-5"
    },
    {
      "path": "/api/cron/consensus-refresh",
      "schedule": "0 11 * * 1-5"
    },
    {
      "path": "/api/cron/consensus-refresh",
      "schedule": "30 11 * * 1-5"
    },
    {
      "path": "/api/cron/consensus-refresh",
      "schedule": "0 12 * * 1-5"
    },
    {
      "path": "/api/cron/consensus-refresh",
      "schedule": "30 12 * * 1-5"
    },
    {
      "path": "/api/cron/consensus-refresh",
      "schedule": "0 16 * * 1-5"
    },
    {
      "path": "/api/cron/consensus-refresh",
      "schedule": "30 16 * * 1-5"
    },
    {
      "path": "/api/cron/consensus-refresh",
      "schedule": "0 17 * * 1-5"
    },
    {
      "path": "/api/cron/consensus-refresh",
      "schedule": "30 17 * * 1-5"
    },
    {
      "path": "/api/cron/consensus-refresh",
      "schedule": "0 18 * * 1-5"
    },
    {
      "path": "/api/cron/consensus-refresh",
      "schedule": "30 18 * * 1-5"
    },
    {
      "path": "/api/cron/consensus-refresh",
      "schedule": "0 19 * * 1-5"
    },
    {
      "path": "/api/cron/consensus-refresh",
      "schedule": "30 19 * * 1-5"
    },
    {
      "path": "/api/cron/consensus-refresh",
      "schedule": "0 20 * * 1-5"
    },
    {
      "path": "/api/cron/consensus-refresh",
      "schedule": "30 20 * * 1-5"
    },
    {
      "path": "/api/cron/consensus-refresh",
      "schedule": "0 21 * * 1-5"
    },
    {
      "path": "/api/cron/consensus-refresh",
      "schedule": "30 21 * * 1-5"
    },
    {
      "path": "/api/cron/consensus-refresh",
      "schedule": "0 22 * * 1-5"
    },
    {
      "path": "/api/cron/consensus-refresh",
      "schedule": "30 22 * * 1-5"
    },
    {
      "path": "/api/cron/consensus-refresh",
      "schedule": "0 23 * * 1-5"
    },
    {
      "path": "/api/cron/consensus-refresh",
      "schedule": "30 23 * * 1-5"
    },
    {
      "path": "/api/cron/warm-rate-cache",
      "schedule": "0 11 * * 1-5"
    },
    {
      "path": "/api/cron/cleanup-abandoned-owners",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron/daily-digest",
      "schedule": "0 13 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
        }
      ]
    }
  ]
}
