{
  "name": "Option Chaser (Vite + Python)",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "20"
    }
  },
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md",
        "src/App.tsx"
      ]
    },
    "vscode": {
      "settings": {},
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "dbaeumer.vscode-eslint"
      ]
    }
  },
  "updateContentCommand": "python3 -m venv .venv; .venv/bin/pip install -e '.[api,yf]' pytest; npm install; echo '✅ Packages installed and Requirements met'",
  "postAttachCommand": {
    "web": "npm run dev -- --host"
  },
  "portsAttributes": {
    "5173": {
      "label": "前端（Vite dev server）",
      "onAutoForward": "openPreview"
    }
  },
  "forwardPorts": [
    5173
  ]
}
