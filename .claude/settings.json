{
  "env": {
    "RICE_SESSION_ARCHIVE": "1"
  },
  "hooks": {
    "SessionEnd": [
      {
        "hooks": [
          {
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/archive_session.py\"",
            "statusMessage": "Archiving session history...",
            "timeout": 60,
            "type": "command"
          }
        ],
        "matcher": "clear"
      }
    ]
  },
  "outputStyle": "老弟伺候大哥",
  "permissions": {
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push * --force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git push +*)",
      "Bash(git push * +*)",
      "Bash(git push --delete *)",
      "Bash(git push * --delete *)",
      "Bash(git push -d *)",
      "Bash(git push * -d *)",
      "Bash(git reset --hard*)",
      "Bash(git rebase*)",
      "Bash(git commit --amend*)",
      "Bash(git filter-branch*)",
      "Bash(git filter-repo*)",
      "Bash(git reflog expire*)",
      "Bash(git clean -f*)",
      "Bash(git branch *)",
      "Bash(git checkout -b *)",
      "Bash(git checkout -B *)",
      "Bash(git checkout --orphan *)",
      "Bash(git switch -c *)",
      "Bash(git switch -C *)",
      "Bash(git switch --create *)",
      "Bash(git worktree add *)",
      "Bash(git stash branch *)",
      "mcp__github__create_branch"
    ]
  }
}
